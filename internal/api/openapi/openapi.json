{
  "openapi": "3.0.3",
  "info": {
    "title": "Nexus API",
    "version": "1.0.0-poc",
    "description": "Servicio único de integración entre SGP y aplicaciones externas (SAP, PEL, AMD, etc.). Este spec describe el contrato público de la PoC — ver docs/03-contrato-api-rest.md en el repositorio para la explicación completa de cada campo y los flujos síncrono/asíncrono. Para probar operaciones protegidas, primero llamá a POST /api/v1/auth/token y pegá el access_token con el botón Authorize."
  },
  "tags": [
    { "name": "infraestructura", "description": "Liveness/readiness, sin autenticación." },
    { "name": "autenticación", "description": "Emisión de JWT a partir de API Key." },
    { "name": "integraciones", "description": "Invocación de integraciones y catálogo." },
    { "name": "jobs", "description": "Ciclo de vida de integraciones asíncronas." }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token obtenido en POST /api/v1/auth/token."
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": ["source_system", "timestamp", "payload"],
        "properties": {
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "description": "Si se omite, Nexus genera uno automáticamente."
          },
          "source_system": { "type": "string", "example": "SGP" },
          "timestamp": { "type": "string", "format": "date-time" },
          "payload": {
            "type": "object",
            "description": "Datos específicos de la integración invocada (ver la ficha de cada integración).",
            "additionalProperties": true
          }
        }
      },
      "SendSuccessResponse": {
        "type": "object",
        "properties": {
          "correlation_id": { "type": "string" },
          "integration_id": { "type": "string" },
          "status": { "type": "string", "example": "SUCCESS" },
          "code": { "type": "string", "example": "NEXUS_OK" },
          "message": { "type": "string" },
          "data": { "type": "object", "additionalProperties": true },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "correlation_id": { "type": "string" },
          "integration_id": { "type": "string" },
          "status": { "type": "string", "example": "ERROR" },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST", "INVALID_ENVELOPE", "INVALID_PAYLOAD",
              "UNAUTHORIZED", "FORBIDDEN", "INTEGRATION_NOT_FOUND",
              "JOB_NOT_FOUND", "JOB_NOT_FINISHED", "DUPLICATE_REQUEST",
              "EXTERNAL_SYSTEM_ERROR", "BUSINESS_RULE_REJECTED",
              "INTEGRATION_UNAVAILABLE", "INTERNAL_ERROR"
            ]
          },
          "message": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "TokenRequest": {
        "type": "object",
        "required": ["client_id", "api_key"],
        "properties": {
          "client_id": { "type": "string", "example": "sgp" },
          "api_key": { "type": "string", "format": "password" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "integer", "example": 900 }
        }
      },
      "IntegrationSummary": {
        "type": "object",
        "properties": {
          "integration_id": { "type": "string" },
          "name": { "type": "string" },
          "direction": { "type": "string", "enum": ["OUTBOUND", "INBOUND", "BIDIRECTIONAL"] },
          "mode": { "type": "string", "enum": ["SYNC", "ASYNC"] },
          "version": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "DISABLED"] }
        }
      },
      "CatalogResponse": {
        "type": "object",
        "properties": {
          "integrations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/IntegrationSummary" }
          }
        }
      },
      "AsyncAcceptedResponse": {
        "type": "object",
        "properties": {
          "correlation_id": { "type": "string" },
          "integration_id": { "type": "string" },
          "job_id": { "type": "string" },
          "status": { "type": "string", "example": "ACCEPTED" },
          "status_url": { "type": "string", "example": "/api/v1/jobs/{job_id}" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "JobProgress": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "nullable": true },
          "processed": { "type": "integer" },
          "failed": { "type": "integer" }
        }
      },
      "JobStatusResponse": {
        "type": "object",
        "properties": {
          "job_id": { "type": "string" },
          "integration_id": { "type": "string" },
          "correlation_id": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED", "PARTIAL"] },
          "progress": { "$ref": "#/components/schemas/JobProgress" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time", "nullable": true },
          "result_url": {
            "type": "string",
            "description": "Solo presente si el job terminó y su delivery_mode es pull_api."
          }
        }
      },
      "JobItemResponse": {
        "type": "object",
        "properties": {
          "external_id": { "type": "string" },
          "status": { "type": "string", "enum": ["SUCCESS", "FAILED"] },
          "data": { "type": "object", "additionalProperties": true },
          "error": { "type": "string" }
        }
      },
      "JobResultSummary": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "success": { "type": "integer" },
          "failed": { "type": "integer" }
        }
      },
      "JobResultResponse": {
        "type": "object",
        "properties": {
          "job_id": { "type": "string" },
          "integration_id": { "type": "string" },
          "summary": { "$ref": "#/components/schemas/JobResultSummary" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JobItemResponse" }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Falta o es inválido el header Authorization.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "El cliente autenticado no tiene el scope requerido.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "El recurso no existe.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["infraestructura"],
        "summary": "Liveness check",
        "responses": {
          "200": { "description": "El proceso está vivo.", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } } } } }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["infraestructura"],
        "summary": "Readiness check (verifica conexión a la base de datos)",
        "responses": {
          "200": { "description": "Listo para recibir tráfico." },
          "503": { "description": "No listo (ej. sin conexión a la base de datos)." }
        }
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "tags": ["autenticación"],
        "summary": "Emite un JWT a partir de client_id + api_key",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenRequest" } } }
        },
        "responses": {
          "200": { "description": "Token emitido.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
          "400": { "description": "Cuerpo inválido.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/integrations": {
      "get": {
        "tags": ["integraciones"],
        "summary": "Catálogo de integraciones disponibles",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Catálogo.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/integrations/{integration_id}/send": {
      "post": {
        "tags": ["integraciones"],
        "summary": "Invoca una integración (síncrona) o dispara una asíncrona",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "integration_id", "in": "path", "required": true, "schema": { "type": "string" }, "example": "mock-echo" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
        },
        "responses": {
          "200": { "description": "Resultado de una integración SYNC.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendSuccessResponse" } } } },
          "202": { "description": "Job aceptado (integración ASYNC).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AsyncAcceptedResponse" } } } },
          "400": { "description": "Envelope o payload inválido.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "Solicitud duplicada en curso.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "El sistema externo rechazó la solicitud por una regla de negocio.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "502": { "description": "Error de comunicación con el sistema externo.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "description": "Integración no disponible.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": ["jobs"],
        "summary": "Consulta el estado de un job asíncrono",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Estado del job.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobStatusResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/jobs/{job_id}/result": {
      "get": {
        "tags": ["jobs"],
        "summary": "Obtiene el resultado detallado de un job terminado (delivery_mode=pull_api)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Resultado del job.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobResultResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "El job todavía no llegó a un estado terminal.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/jobs/{job_id}/ack": {
      "post": {
        "tags": ["jobs"],
        "summary": "Confirma que el resultado del job ya fue consumido",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Confirmado." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}
