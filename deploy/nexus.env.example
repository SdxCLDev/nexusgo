# Copia este archivo a "nexus.env" (sin ".example") junto al binario, y
# completa los valores reales. nexus.env esta en .gitignore -- nunca se
# commitea, asi que es un buen lugar para los secretos de este server.
#
# El servicio systemd (ver nexus.service) lo carga via EnvironmentFile.
#
# Fuera del ambiente "dev", NEXUS_JWT_SECRET y NEXUS_SGP_API_KEY son
# obligatorias -- sin ellas Nexus no arranca (ver internal/config/config.go).

NEXUS_ENV=prod

# 127.0.0.1: Nexus solo escucha en localhost -- nginx es quien lo expone a
# internet (ver nexus.nginx.conf). No exponer Nexus directamente en 0.0.0.0.
NEXUS_HTTP_ADDR=127.0.0.1:8080

NEXUS_JWT_SECRET=reemplazar-por-un-secreto-largo-y-unico
NEXUS_SGP_API_KEY=reemplazar-por-la-api-key-real-que-usara-sgp
NEXUS_DB_PATH=/opt/nexus/nexus.db

# Debe coincidir con el path del location de nginx (ver nexus.nginx.conf) --
# Nexus lo usa para construir status_url/result_url y el spec OpenAPI de
# forma que funcionen a traves del proxy. Dejar vacio si se publica en la raiz.
NEXUS_PUBLIC_BASE_PATH=/nexus
