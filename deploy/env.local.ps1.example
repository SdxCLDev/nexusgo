# Copia este archivo a "env.local.ps1" (sin ".example") junto a run.ps1, y
# completa los valores reales. env.local.ps1 esta en .gitignore -- nunca se
# commitea, asi que es un buen lugar para los secretos de este server.
#
# run.ps1 lo carga automaticamente si existe (no hace falta nada mas: no
# toca el registro de Windows ni requiere ejecutar como Administrador).
#
# Fuera del ambiente "dev", NEXUS_JWT_SECRET y NEXUS_SGP_API_KEY son
# obligatorias -- sin ellas Nexus no arranca (ver internal/config/config.go).

$env:NEXUS_ENV = "prod"
$env:NEXUS_JWT_SECRET = "<reemplazar-por-un-secreto-largo-y-unico>"
$env:NEXUS_SGP_API_KEY = "<reemplazar-por-la-api-key-real-que-usara-sgp>"
$env:NEXUS_DB_PATH = "C:\Nexus\nexus.db"
$env:NEXUS_HTTP_ADDR = ":8080"
